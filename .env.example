IMOVEL_HOST=127.0.0.1
IMOVEL_PORT=8766
# Optional absolute path. Default: data/radar.sqlite3
# IMOVEL_DB_PATH=
IMOVEL_TIMEZONE=America/Sao_Paulo
IMOVEL_REFRESH_HOUR=7
# Local migration only; only the installation's first account can use this.
IMOVEL_ENABLE_LEGACY_IMPORT=0

# Optional walking-route enrichment; keep the real key only in .env
GOOGLE_MAPS_API_KEY=
IMOVEL_GEOCODE_LIMIT=20

# osm: rotas gratuitas limitadas com OpenStreetMap/FOSSGIS; google: chave com faturamento ativo
IMOVEL_METRO_PROVIDER=osm
